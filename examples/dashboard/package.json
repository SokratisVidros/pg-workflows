{
  "name": "pg-workflows-dashboard-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:engine": "test -d ../../packages/pg-workflows/dist || bun run --filter pg-workflows build",
    "dev": "bun run build:engine && dotenvx run -- next dev",
    "build": "bun run build:engine && next build",
    "start": "dotenvx run -- next start",
    "seed": "bun run build:engine && dotenvx run -- bun scripts/seed.ts",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@pg-workflows/ui": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "next": "^16.3.2",
    "pg": "catalog:",
    "pg-workflows": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "catalog:",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  }
}
