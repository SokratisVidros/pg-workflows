{
  "name": "pg-workflows-monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "examples/*"
    ],
    "catalog": {
      "typescript": "^5.9.3",
      "vitest": "^4.1.11",
      "zod": "^4.5.4",
      "pg": "^8.23.0",
      "pg-boss": "^12.29.0",
      "@types/pg": "^8.23.1",
      "@types/node": "^22.10.2",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.5",
      "@tanstack/react-query": "^5.102.8",
      "tailwindcss": "^4.3.3",
      "@dotenvx/dotenvx": "^2.23.0"
    }
  },
  "scripts": {
    "build": "bun run --filter pg-workflows build && bun run --filter '@pg-workflows/ui' build",
    "build:ui": "bun run --filter '@pg-workflows/ui' build",
    "dev": "bun run --filter pg-workflows dev",
    "test": "bun run test:unit && bun run test:ui && bun run test:integration",
    "test:unit": "bun run --filter pg-workflows test:unit",
    "test:ui": "bun run --filter '@pg-workflows/ui' test",
    "test:integration": "bun run --filter pg-workflows test:integration",
    "test:watch": "bun run --filter pg-workflows test:watch",
    "check-types": "bun run --filter './packages/*' check-types",
    "check-types:ui": "bun run --filter '@pg-workflows/ui' check-types",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "clean": "bun run --filter '*' clean"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
