{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "types": []
  },
  "include": ["src/**/*"],
  "exclude": [
    "dist",
    "node_modules",
    "standalone",
    "vite.config.ts",
    "src/test-setup.ts",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
