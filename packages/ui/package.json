{
  "name": "@pg-workflows/ui",
  "version": "0.2.0",
  "description": "React UI for pg-workflows: browse runs and inspect step timelines.",
  "keywords": [
    "pg-workflows",
    "workflow",
    "workflow-engine",
    "dashboard",
    "react",
    "durable-execution",
    "postgresql"
  ],
  "author": "sokratisvidros<sokratis.vidros@gmail.com>",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/styles.css",
    "./dist/styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "default": "./dist/next/index.js"
    },
    "./tailwind": {
      "types": "./dist/tailwind-preset.d.ts",
      "default": "./dist/tailwind-preset.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "bun run build:lib && bun run build:standalone",
    "build:lib": "tsc -p tsconfig.build.json && node scripts/fix-esm-extensions.mjs && cp src/styles.css dist/styles.css",
    "build:standalone": "vite build",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "node ../../scripts/assert-bun-publish.mjs && bun run clean && bun run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "@tanstack/react-query": ">=5",
    "tailwindcss": "^4",
    "pg-workflows": ">=0.17.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "catalog:",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.0",
    "pg-workflows": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.2.2",
    "vitest": "catalog:"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/SokratisVidros/pg-workflows.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/SokratisVidros/pg-workflows/issues"
  },
  "homepage": "https://github.com/SokratisVidros/pg-workflows/tree/main/packages/ui#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "pg-workflows-ui": "./bin/pg-workflows-ui.mjs"
  }
}
